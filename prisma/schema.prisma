generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// RLS is explicitly DISABLED (default-deny) on all tables Prisma touches.
/// Enforcement happens at the API layer via code-level role checks in serverless
/// functions. Do NOT add Supabase RLS policies to these tables — Prisma's
/// service-role connection bypasses RLS, so policies would silently do nothing
/// or, worse, conflict with the API-layer checks.

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  position  String
  role      String   // "super_admin" | "staff" | "client"
  canManageContent Boolean @default(false)
  canDelegate Boolean @default(false) // may grant temporary per-event access (President/Secretary)
  canConfigure Boolean @default(false) // may set retention + check-in windows (adviser, officer in charge, ...)
  mustChangePassword Boolean @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  /// Consent record (plan §11.2, benchmark BC-1): what the student agreed to and
  /// when. Nullable because accounts that predate this have no recorded consent —
  /// inventing one would be worse than admitting the gap.
  consentAt      DateTime?
  consentVersion String?
  consentSource  String?

  createdEvents Event[]       @relation("EventCreator")
  cancelledEvents Event[]     @relation("EventCanceller")
  attendance    Attendance[]
  recorded      Attendance[]  @relation("RecordedBy")
  officeDuties  OfficeDuty[]
  delegations        EventDelegate[] @relation("DelegateUser")
  grantedDelegations EventDelegate[] @relation("DelegateGranter")
  revokedDelegations EventDelegate[] @relation("DelegateRevoker")
  studentProfile     StudentProfile?
  roles              UserRole[]
  savedViews         SavedView[]
  registrations      EventRegistration[]
  notifications      Notification[]      @relation("NotificationUser")
  createdNotifications Notification[]    @relation("NotificationCreator")
  notificationPreference NotificationPreference? @relation("NotificationPreference")
  announcements      Announcement[]      @relation("AnnouncementCreator")
  expectedRosters    EventExpected[]     @relation("ExpectedStudent")
  fines              Fine[]              @relation("FineOwner")
  finesPaid          Fine[]              @relation("FinePaidBy")
  fineWaivers        Fine[]              @relation("FineWaivedBy")
  finesServed        Fine[]              @relation("FineServedBy")
  excuses            Excuse[]            @relation("ExcuseOwner")
  excusesReviewed    Excuse[]            @relation("ExcuseReviewer")
  budgetsCreated     Budget[]            @relation("BudgetCreator")
  budgetEntries      BudgetEntry[]       @relation("BudgetEntryRecorder")
  proposalsCreated   BudgetProposal[]    @relation("ProposalCreator")
  proposalSteps      ProposalStep[]      @relation("ProposalStepActor")
  documents          Document[]          @relation("DocumentCreator")
  documentVersions   DocumentVersion[]   @relation("DocumentVersionCreator")
  documentAttachments DocumentAttachment[] @relation("DocumentAttachmentCreator")
  payments           Payment[]           @relation("PaymentStudent")
  paymentsReceived   Payment[]           @relation("PaymentReceiver")
  clearances         Clearance[]         @relation("ClearanceStudent")
  clearancesIssued   Clearance[]         @relation("ClearanceIssuer")
  clearancesRevoked  Clearance[]         @relation("ClearanceRevoker")

  @@map("users")
}

/// Capability-based RBAC (plan §7.2). `roles` are bundles of capabilities;
/// `user_roles` assigns them. The legacy `role`/`can*` columns stay in sync
/// (they are what the still-live Vite app reads) until the cutover.
model Role {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  system       Boolean  @default(false)
  createdAt    DateTime @default(now())

  capabilities RoleCapability[]
  users        UserRole[]

  @@map("roles")
}

model RoleCapability {
  roleId     String
  capability String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, capability])
  @@index([capability])
  @@map("role_capabilities")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Free-tier hardening (plan §11.1): one row per outbound transactional email,
/// kind + timestamp only — never the recipient.
/// See server/utils/email-quota.ts for the daily guard.
model EmailSend {
  id        String   @id @default(uuid())
  kind      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("email_sends")
}

/// A saved table view (plan §8.1): the query string a table puts in the URL,
/// stored per user + resource + name so it can be restored with one click.
model SavedView {
  id        String   @id @default(uuid())
  userId    String
  resource  String
  name      String
  query     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, name])
  @@map("saved_views")
}

model Event {
  id           String   @id @default(uuid())
  title        String
  date         DateTime
  lat          Float
  lng          Float
  radiusMeters Int      @default(50)
  checkInOpensAt  DateTime? // null = no limit
  checkInClosesAt DateTime? // null = no limit
  /// Calendar grouping (plan §8.2); colour comes from the category.
  categoryId           String?
  /// Seat limit for attendance/registration; null = unlimited.
  capacity             Int?
  /// True when students are expected to register ahead of the event.
  registrationRequired Boolean @default(false)
  createdBy    String
  creator      User     @relation("EventCreator", fields: [createdBy], references: [id])
  category     EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attendance   Attendance[]
  delegates    EventDelegate[]
  registrations EventRegistration[]
  createdAt    DateTime @default(now())

  /// Required audience (plan §8.2): who must attend — the "expected" side of
  /// analytics and, in P4, who gets absence fines. "all" = every active
  /// student. The references are Restrict on purpose: widening an audience by
  /// accident (a deleted college) would be worse than refusing the delete.
  audienceType      String  @default("all")
  audienceCollegeId String?
  audienceYearLevel Int?
  audienceSectionId String?
  audienceCollege   College? @relation("EventAudienceCollege", fields: [audienceCollegeId], references: [id])
  audienceSection   Section? @relation("EventAudienceSection", fields: [audienceSectionId], references: [id])

  /// Fines (plan §8.5): when the nightly generation ran for this event, which is
  /// what makes it idempotent, and its optional rule override.
  finesIssuedAt DateTime?
  fineRule      FineRule? @relation("EventFineRule")
  fines         Fine[]

  /// The expected roster frozen when the window closed (benchmark BC-4), one
  /// row per person. Reports and fines read this, never a live resolve.
  expected      EventExpected[]

  /// Cancellation (benchmark BC-7). One-way on purpose: a cancelled event is a
  /// record of something called off, and re-instating it would quietly re-arm the
  /// fines and reminders. Cancelled events are inert — no reminders, no fines,
  /// no registration, no check-in.
  status       String    @default("scheduled") // scheduled | cancelled
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?
  canceller    User?     @relation("EventCanceller", fields: [cancelledBy], references: [id], onDelete: SetNull)

  /// Recurring series (plan §8.2): the master carries the rule, the later
  /// instances point back at it. Instances are real events so attendance and
  /// registration stay per occurrence.
  seriesId        String?
  rrule           String?
  recurrenceIndex Int?
  series      Event?  @relation("EventSeries", fields: [seriesId], references: [id], onDelete: Cascade)
  occurrences Event[] @relation("EventSeries")

  /// Finance (plan §8.7): proposals raised for this event, so a liquidation
  /// report can be produced per event.
  proposals BudgetProposal[] @relation("ProposalEvent")

  /// Documents filed against this event (plan §8.8): minutes, resolutions, reports.
  documents   Document[] @relation("DocumentEvent")

  @@index([categoryId])
  @@index([seriesId])
  @@map("events")
}

/// Who is coming to an event (plan §8.2): a seat, or a place in the queue./// Cancelling keeps the row so re-registering reuses it and the history stays
/// readable.
model EventRegistration {
  id         String   @id @default(uuid())
  eventId    String
  userId     String
  status     String   // "registered" | "waitlisted" | "cancelled"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  promotedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
  @@map("event_registrations")
}

/// The expected roster, frozen when an event's check-in window closes (benchmark
/// BC-4, plan §8.2/§8.3/§8.5): one row per expected person per event, with the
/// placement that explained them at that moment. Reports, Student 360 and the
/// fine generator read this instead of resolving live, so a later transfer
/// cannot change who was charged or make an old export unreproducible.
///
/// `source` is the event's audience type at snapshot time. The placement columns
/// are copied text rather than foreign keys on purpose: they are a record of
/// history, not a current reference. The event/user links cascade because a
/// deleted event or person must not leave orphan expectations.
model EventExpected {
  id         String   @id @default(uuid())
  eventId    String
  userId     String
  source     String   // all | college | yearLevel | section
  collegeId  String?
  yearLevel  Int?
  sectionId  String?
  snapshotAt DateTime
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("ExpectedStudent", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_expected")
}

/// In-app notifications (plan §8.4). `dedupeKey` makes the reminder cron safe to
/// re-run: the unique (userId, dedupeKey) index refuses a second row for the
/// same event and window (NULL keys are distinct, so one-offs are unaffected).
model Notification {
  id        String    @id @default(uuid())
  userId    String
  kind      String
  title     String
  body      String
  link      String?
  dedupeKey String?
  /// How it was delivered: "inApp" | "email" | "push". The inbox shows rows that
  /// carry "inApp"; every row is kept so the cron can tell what it already sent.
  channels  String[]
  readAt    DateTime?
  createdBy String?
  createdAt DateTime  @default(now())

  user    User  @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  creator User? @relation("NotificationCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Per-user channel choices. A missing row means the defaults (in-app and email
/// on, push off until the PWA channel lands).
model NotificationPreference {
  userId    String   @id
  inApp     Boolean  @default(true)
  email     Boolean  @default(true)
  push      Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation("NotificationPreference", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// An announcement (plan §8.4): written once, targeted with the same audience
/// columns as events, then sent now or left for the cron. Its delivery log is
/// the notifications it produces (kind 'announcement', dedupe key
/// 'announcement:<id>'), which is what makes the cron safe to re-run.
model Announcement {
  id           String    @id @default(uuid())
  title        String
  body         String
  pinned       Boolean   @default(false)
  status       String    @default("draft") // draft | scheduled | sent | cancelled
  scheduledFor DateTime?
  sentAt       DateTime?
  audienceType      String  @default("all")
  audienceCollegeId String?
  audienceYearLevel Int?
  audienceSectionId String?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  creator         User      @relation("AnnouncementCreator", fields: [createdBy], references: [id])
  audienceCollege College?  @relation("AnnouncementAudienceCollege", fields: [audienceCollegeId], references: [id])
  audienceSection Section?  @relation("AnnouncementAudienceSection", fields: [audienceSectionId], references: [id])

  @@index([status, scheduledFor])
  @@index([pinned, status])
  @@map("announcements")
}

/// Fine rules (plan §8.5): one row per scope — global, one event, one category —
/// with event > category > global precedence resolved in `server/utils/fines.ts`.
/// Money is in centavos so nothing rounds twice.
model FineRule {
  id               String   @id @default(uuid())
  scope            String   @default("global") // global | event | category
  eventId          String?  @unique
  categoryId       String?  @unique
  absentCentavos   Int      @default(5000)
  lateCentavos     Int      @default(2500)
  /// D-05: fifteen minutes by default; every event can override it.
  lateAfterMinutes Int      @default(15)
  /// D-01: what a breach costs, and the citation that permits charging money.
  /// Monetary applies to officers only, and only when `authorityRef` is present.
  sanctionType     String   @default("warning") // monetary | warning | service
  authorityRef     String?
  effectiveFrom    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  event    Event?          @relation("EventFineRule", fields: [eventId], references: [id], onDelete: Cascade)
  category EventCategory?  @relation("CategoryFineRule", fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("fine_rules")
}

/// One fine per student per event. Generated after the check-in window closes;
/// an approved excuse waives it (P4c) and a Treasurer payment settles it (P4d).
model Fine {
  id             String    @id @default(uuid())
  userId         String
  eventId        String
  kind           String // absent | late
  /// D-01: monetary (officers, with a citation), warning, or service.
  sanctionType   String    @default("monetary")
  amountCentavos Int
  status         String    @default("unpaid") // unpaid | paid | waived
  ruleSnapshot   Json?
  issuedAt       DateTime  @default(now())
  paidAt         DateTime?
  paidBy         String?
  paymentRef     String?
  waivedAt       DateTime?
  waivedBy       String?
  waiveReason    String?
  /// D-01: a service sanction is an obligation until it is served.
  servedAt       DateTime?
  servedBy       String?
  servedNote     String?

  user   User  @relation("FineOwner", fields: [userId], references: [id], onDelete: Cascade)
  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payer  User? @relation("FinePaidBy", fields: [paidBy], references: [id], onDelete: SetNull)
  waiver User? @relation("FineWaivedBy", fields: [waivedBy], references: [id], onDelete: SetNull)
  server User? @relation("FineServedBy", fields: [servedBy], references: [id], onDelete: SetNull)
  excuses Excuse[]
  payment Payment?

  @@unique([userId, eventId])
  @@index([userId, status])
  @@index([userId, sanctionType, status])
  @@index([eventId])
  @@index([status])
  @@map("fines")
}

/// A Treasurer's record of a settled fine (plan §8.5): one payment settles one
/// fine in full. The reference is the OR number (cash) or the GCash reference.
model Payment {
  id             String   @id @default(uuid())
  fineId         String   @unique
  userId         String
  amountCentavos Int
  method         String // cash | gcash
  reference      String
  note           String?
  receivedBy     String
  receivedAt     DateTime @default(now())

  fine     Fine @relation(fields: [fineId], references: [id], onDelete: Cascade)
  student  User @relation("PaymentStudent", fields: [userId], references: [id], onDelete: Cascade)
  receiver User @relation("PaymentReceiver", fields: [receivedBy], references: [id])

  @@index([userId])
  @@index([receivedAt])
  @@map("payments")
}

/// A clearance certificate issued when a student owes nothing (plan §8.5). The
/// code is what the public /verify page checks, and the live status is
/// recomputed at verification time — a later fine makes an old certificate read
/// "no longer cleared", which is the tamper check the plan asks for.
model Clearance {
  id              String    @id @default(uuid())
  userId          String
  code            String    @unique
  coveredCentavos Int
  coveredFines    Json?
  issuedBy        String
  issuedAt        DateTime  @default(now())
  revokedAt       DateTime?
  revokedBy       String?
  note            String?

  student User  @relation("ClearanceStudent", fields: [userId], references: [id], onDelete: Cascade)
  issuer  User  @relation("ClearanceIssuer", fields: [issuedBy], references: [id])
  revoker User? @relation("ClearanceRevoker", fields: [revokedBy], references: [id], onDelete: SetNull)

  @@index([userId, issuedAt])
  @@map("clearances")
}

/// An excuse filed against a fine (plan §8.5). Approving it waives the fine.
/// The attachment lives in object storage (or the DB in development) and the row
/// keeps only its key, type and size.
model Excuse {
  id             String    @id @default(uuid())
  fineId         String
  userId         String
  category       String    @default("other") // medical | academic | other
  reason         String
  status         String    @default("pending") // pending | approved | denied
  attachmentKey  String?
  attachmentMime String?
  attachmentSize Int?
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())

  fine     Fine  @relation(fields: [fineId], references: [id], onDelete: Cascade)
  student  User  @relation("ExcuseOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ExcuseReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([fineId])
  @@map("excuses")
}

/// A semester budget (plan §8.7): one per semester, split into line items.
/// Amounts are integer **centavos** like every other money field in this schema.
model Budget {
  id         String   @id @default(uuid())
  semesterId String   @unique
  /// open = the spending term; closed = kept for the record, new expenses refused.
  status     String   @default("open")
  notes      String?
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  semester Semester         @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  creator  User             @relation("BudgetCreator", fields: [createdBy], references: [id])
  lines    BudgetLine[]
  proposals BudgetProposal[]

  @@map("budgets")
}

/// One line of a budget ("Office supplies", "Pag-abi-abi event"). `allocatedCentavos`
/// is what the council planned to spend; income and expenses are recorded as
/// `budget_entries` against the line, so remaining = allocated + income − expenses.
model BudgetLine {
  id                String   @id @default(uuid())
  budgetId          String
  name              String
  category          String   @default("other") // supplies | events | travel | communication | other
  allocatedCentavos Int      @default(0)
  notes             String?
  sortOrder         Int      @default(0)
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  budget    Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  entries   BudgetEntry[]
  proposals BudgetProposal[]

  @@unique([budgetId, name])
  @@index([budgetId, sortOrder])
  @@map("budget_lines")
}

/// Money actually moved (plan §8.7): an expense with its receipt, or income such
/// as collected fines and fees. An expense may be tied to the proposal that
/// authorised it, which is what the liquidation report reconciles.
model BudgetEntry {
  id             String   @id @default(uuid())
  lineId         String
  kind           String // income | expense
  amountCentavos Int
  description    String
  /// Where income came from ("fines" | "fees" | "donation" | "other"); null for expenses.
  source         String?
  spentAt        DateTime
  proposalId     String?
  /// Receipt in object storage (plan §11.1 — never the database). The row keeps
  /// only the key, type, size and original filename.
  receiptKey  String?
  receiptMime String?
  receiptSize Int?
  receiptName String?
  /// Set when the line's remaining budget was deliberately exceeded (plan §8.7
  /// acceptance: an override is explicit and audited).
  overrideReason String?
  recordedBy     String
  createdAt      DateTime @default(now())

  line     BudgetLine      @relation(fields: [lineId], references: [id], onDelete: Cascade)
  proposal BudgetProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  recorder User            @relation("BudgetEntryRecorder", fields: [recordedBy], references: [id])

  @@index([lineId, spentAt])
  @@index([proposalId])
  @@index([kind, spentAt])
  @@map("budget_entries")
}

/// A budget proposal (plan §8.7): decided by the body in a meeting (minutes
/// linked), noted by the President, the Adviser and the University Accountant,
/// approved by the Campus Administrator, released, then liquidated. The steps
/// live in `proposal_steps` — every one of them time-stamped and audited — and
/// the status here is the derived position in that state machine.
model BudgetProposal {
  id             String   @id @default(uuid())
  budgetId       String
  lineId         String?
  eventId        String?
  /// Used when the proposal is for a project rather than a calendar event.
  projectName    String?
  title          String
  description    String
  /// What the body approved, in centavos.
  amountCentavos Int
  status         String   @default("decided") // decided | noted | approved | released | liquidated | rejected
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  budget  Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  line    BudgetLine?    @relation(fields: [lineId], references: [id], onDelete: SetNull)
  event   Event?         @relation("ProposalEvent", fields: [eventId], references: [id], onDelete: SetNull)
  creator User           @relation("ProposalCreator", fields: [createdBy], references: [id])
  steps   ProposalStep[]
  entries BudgetEntry[]

  @@index([budgetId, status])
  @@index([lineId])
  @@index([eventId])
  @@map("budget_proposals")
}

/// One recorded step of a proposal. The University Accountant and the Campus
/// Administrator are external signatories (plan §8.7): the Treasurer records
/// their step with the date and the signed copy, so no account is needed — the
/// signatory's name and role are kept here and the uploader stays visible in
/// `actorUserId`.
model ProposalStep {
  id            String   @id @default(uuid())
  proposalId    String
  step          String // decided | noted_president | noted_adviser | noted_university_accountant | approved | released | liquidated | rejected
  /// The officer who recorded the step (the Treasurer for external signatories).
  actorUserId   String?
  /// Who actually signed, for the external steps.
  signatoryName String?
  signatoryRole String?
  /// The date the step happened (the meeting / signing date), UTC.
  actedAt       DateTime @default(now())
  note          String?
  /// Signed copy of the noting/approval, in object storage.
  attachmentKey  String?
  attachmentMime String?
  attachmentSize Int?
  attachmentName String?
  createdAt      DateTime @default(now())

  proposal BudgetProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  actor    User?          @relation("ProposalStepActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([proposalId, step])
  @@index([step, actedAt])
  @@map("proposal_steps")
}

/// Finance-wide switches (plan §8.7). One row, like `org_profile`. The
/// transparency board is off until the council turns it on.
model FinanceSettings {
  id                 String   @id @default(uuid())
  transparencyPublic Boolean  @default(false)
  /// Optional line shown under the public totals ("figures as of the 2nd
  /// semester A.Y. 2026-2027"). Never personal names.
  transparencyNote   String?
  updatedBy          String?
  updatedAt          DateTime @updatedAt

  @@map("finance_settings")
}

/// Colour-coded event categories (plan §8.2): General Assembly, Flag Ceremony,
/// Seminar, …. Editable by settings managers; archived rather than deleted
/// while events still reference them.
model EventCategory {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  color     String   @default("#C9A24B")
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  events Event[]
  fineRule FineRule? @relation("CategoryFineRule")

  @@map("event_categories")
}

model Attendance {
  id         String    @id @default(uuid())
  type       String    @default("event") // "event" | "duty"
  eventId    String?
  dutyDate   DateTime? // required if type = "duty"
  userId     String
  method     String    // "self" | "manual" | "qr"
  lat        Float?
  lng        Float?
  recordedBy String
  createdAt  DateTime  @default(now())
  checkOutAt DateTime?

  event    Event?  @relation(fields: [eventId], references: [id])
  user     User    @relation(fields: [userId], references: [id])
  recorder User    @relation("RecordedBy", fields: [recordedBy], references: [id])
  signature AttendanceSignature?

  @@map("attendance")
}

/// Academic semesters. A signature belongs to the semester its signing time falls in.
model Semester {
  id        String   @id @default(uuid())
  name      String
  startsOn  DateTime
  endsOn    DateTime // exclusive end
  createdAt DateTime @default(now())

  /// Finance (plan §8.7): at most one budget per semester.
  budgets   Budget[]

  @@index([startsOn])
  @@map("semesters")
}

/// Extra identity data for self-registered students (role = "student").
model StudentProfile {
  userId    String   @id
  studentNo String   @unique
  program   String?
  /// Academic placement (P1: reference data below); nullable so accounts
  /// created before the reference tables stay valid.
  collegeId     String?
  programId     String?
  yearLevel     Int?
  sectionId     String?
  contactNumber String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  programRef Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([programId])
  @@index([sectionId])
  @@map("student_profiles")
}

/// Academic reference data (plan §8.1) — all editable by admins. Renames happen
/// through the foreign keys (never copied text); rows referenced by students
/// cannot be deleted, only archived.
model College {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  programs Program[]
  students StudentProfile[]
  eventsAsAudience Event[] @relation("EventAudienceCollege")
  announcementsAsAudience Announcement[] @relation("AnnouncementAudienceCollege")

  @@map("colleges")
}

/// A program belongs to a college. `yearLevels` is the programme's length
/// (default 4, editable — e.g. a 5-year course).
model Program {
  id         String   @id @default(uuid())
  collegeId  String
  code       String
  name       String
  yearLevels Int      @default(4)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  college  College          @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  sections Section[]
  students StudentProfile[]

  @@unique([collegeId, code])
  @@map("programs")
}

/// A section belongs to a program + year level; names are encoded by the admin
/// (they vary per term).
model Section {
  id        String   @id @default(uuid())
  programId String
  yearLevel Int
  name      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  program  Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  students StudentProfile[]
  eventsAsAudience Event[] @relation("EventAudienceSection")
  announcementsAsAudience Announcement[] @relation("AnnouncementAudienceSection")

  @@unique([programId, yearLevel, name])
  @@map("sections")
}

/// The attendee's own drawn signature for one attendance record (PNG), kept
/// apart from "attendance" so roster queries never pull image bytes.
model AttendanceSignature {
  attendanceId String   @id
  png          Bytes?   // null once purged by the retention rule (or stored in R2)
  sha256       String
  signedAt     DateTime @default(now())
  purgedAt     DateTime?
  /// Object-storage key when the image lives in R2 (plan §11.1); rows written
  /// before the switch keep their bytes in `png`. Readers go by the row.
  storageKey     String?
  storageBackend String?

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@map("attendance_signatures")
}

/// Temporary, per-event access granted by an officer with canDelegate.
/// Valid only while revokedAt is null and expiresAt is in the future.
model EventDelegate {
  id        String    @id @default(uuid())
  eventId   String
  userId    String    // the officer receiving access
  scopes    String[]  // "scan" | "manual_checkin" | "view_roster" | "export"
  grantedBy String
  expiresAt DateTime
  revokedAt DateTime?
  revokedBy String?
  createdAt DateTime  @default(now())

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User  @relation("DelegateUser", fields: [userId], references: [id])
  granter User  @relation("DelegateGranter", fields: [grantedBy], references: [id])
  revoker User? @relation("DelegateRevoker", fields: [revokedBy], references: [id])

  @@index([eventId, userId])
  @@index([userId, expiresAt])
  @@map("event_delegates")
}

model OfficeDuty {
  id        String  @id @default(uuid())
  userId    String
  dayOfWeek Int     // 0 = Sunday .. 6 = Saturday
  startTime String  // "08:00"
  endTime   String  // "17:00"
  active    Boolean @default(true)
  user      User    @relation(fields: [userId], references: [id])

  @@map("office_duties")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  // user being acted upon (nullable for system actions)
  action      String   // "account_created", "password_changed", "password_reset", "officer_deactivated", "role_changed", "manual_override"
  details     String?  // JSON string with additional context
  performedBy String?  // user ID of the admin/system performing the action
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

model OrgProfile {
  id                  String @id @default(uuid())
  dutyCheckInCutoff   String @default("12:00") // HH:mm 24hr — duty check-ins must occur before this
  dutyCheckOutStart   String @default("12:00") // HH:mm 24hr — duty check-outs must occur at or after this

  @@map("org_profile")
}

model Photo {
  id             String   @id @default(uuid())
  eventSlug      String
  storageKeyFull String
  storageKeyThumb String
  batchTag       String?
  studentTag     String?
  uploadedBy     String
  createdAt      DateTime @default(now())

  @@index([eventSlug])
  @@map("photos")
}

model PublicEvent {
  id           String   @id
  title        String
  date         DateTime
  endDate      DateTime?
  description  String
  location     String
  venue        String?
  status       String   @default("upcoming")
  featured     Boolean  @default(false)
  coverImage   String?
  gallery      Json?
  trailerUrl   String?
  tags         Json?
  icon         String?
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("public_events")
}

model Officer {
  id           String   @id @default(uuid())
  name         String
  position     String
  tier         String
  email        String?
  photo        String?
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("cms_officers")
}

model Project {
  id           String   @id @default(uuid())
  title        String
  description  String
  icon         String
  category     String
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("cms_projects")
}

model SiteContent {
  id        String   @id @default(uuid())
  key       String   @unique
  content   Json
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_submissions")
}

model Settings {
  id                  String   @id @default(uuid())
  currentAcademicYear String   @default("2026-2027")
  signatureRetentionSemesters Int @default(1) // keep a signature image for this many semesters (the one it was signed in counts as 1)
  purgeGraceDays              Int @default(30)
  lastPurgeAt                 DateTime?
  lastPurgeCount              Int?
  updatedAt           DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Documents & resolutions archive (plan §8.8)
// ---------------------------------------------------------------------------

/// A filing type — minutes, resolutions, memos, constitution/by-laws, reports —
/// with the prefix its numbers carry and the zero-padding of the sequence
/// ("Resolution No. 2026-014" = prefix "Resolution No.", pad 3). Editable; the
/// seeded five are a starting point, never a closed list.
model DocumentType {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  prefix    String
  pad       Int      @default(3)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  documents Document[]
  sequences DocumentSequence[]

  @@map("document_types")
}

/// The per-type, per-year counter. One row per type+year, bumped by a single
/// atomic `INSERT … ON CONFLICT DO UPDATE … RETURNING`, so two officers filing
/// at the same instant can never draw the same number. Numbers are never reset,
/// never reused and never handed back (a failed create burns its number on
/// purpose — see server/utils/documents.ts).
model DocumentSequence {
  typeId    String
  year      Int
  last      Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  type DocumentType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@id([typeId, year])
  @@map("document_sequences")
}

/// One archived document. The row carries the *current* version's content so
/// lists and search stay a single-table read; every version is kept forever in
/// `document_versions`. `searchText` is the search corpus (title + body + tags +
/// the text extracted from every attachment) and the GIN-indexed `searchVector`
/// tsvector column is generated from it by the migration, not by the app.
///
/// `financeRef` is a free-text reference (budget line / liquidation code) until
/// the P6 finance tables land and a real foreign key can replace it.
model Document {
  id             String   @id @default(uuid())
  typeId         String
  year           Int
  sequence       Int
  number         String   @unique
  title          String
  body           String   @db.Text
  tags           String[]
  /// Legacy mirror kept in step with `classification` so older queries, exports
  /// and the live app keep working. Never authoritative: `classification` is.
  visibility     String   @default("officers") // public | officers
  /// BC-9: public | officers | restricted. Only `public` may be served without a
  /// session, and only through `redactedVersion` when one is set.
  classification String   @default("officers")
  currentVersion Int      @default(1)
  archived       Boolean  @default(false)
  searchText     String   @default("") @db.Text
  /// tsvector generated from `searchText` by the migration (see the add_documents
  /// migration); queried with $queryRaw, never written through Prisma.
  searchVector   Unsupported("tsvector")?
  /// The corpus a visitor may search: the redacted copy's text when one is in
  /// force, otherwise the same text the officers search. Maintained on every
  /// content change, so a public search can never match a redacted phrase.
  publicSearchText String @default("") @db.Text
  /// tsvector generated from `publicSearchText` by the document_classification
  /// migration; queried with $queryRaw, never written through Prisma.
  publicSearchVector Unsupported("tsvector")?
  /// The version prepared for publication (a derivative, never the original).
  redactedVersionId String?
  /// What was removed, or why the existing text was already safe.
  redactionNote  String?
  eventId        String?
  financeRef     String?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  type            DocumentType         @relation(fields: [typeId], references: [id])
  event           Event?               @relation("DocumentEvent", fields: [eventId], references: [id], onDelete: SetNull)
  creator         User                 @relation("DocumentCreator", fields: [createdBy], references: [id])
  versions        DocumentVersion[]
  attachments     DocumentAttachment[]
  redactedVersion DocumentVersion?     @relation("DocumentRedactedVersion", fields: [redactedVersionId], references: [id], onDelete: SetNull)

  @@index([typeId, year])
  @@index([visibility, archived, createdAt])
  @@index([classification, archived, createdAt])
  @@map("documents")
}

/// One immutable version of a document: the content as it stood, who wrote it
/// and when. Editing a document appends a version; nothing here is ever
/// updated, so the older wording stays readable exactly as it was filed.
model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  version    Int
  title      String
  body       String   @db.Text
  tags       String[]
  visibility String
  changeNote String?
  /// BC-9: a derivative prepared for publication, not a new state of the
  /// record. It stays in the immutable history next to the version it redacts.
  isRedacted Boolean  @default(false)
  createdBy  String
  createdAt  DateTime @default(now())

  document    Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator     User                 @relation("DocumentVersionCreator", fields: [createdBy], references: [id])
  attachments DocumentAttachment[]
  /// Documents whose public copy is this version (at most one per document).
  redactedFor Document[]           @relation("DocumentRedactedVersion")

  @@unique([documentId, version])
  @@index([documentId, version])
  @@map("document_versions")
}

/// A file that came with a document. Bytes live in object storage (never the
/// database — plan §11.1) and the row keeps the key, the metadata and the text
/// extracted at upload time, which is what makes a phrase inside the file
/// searchable.
model DocumentAttachment {
  id              String    @id @default(uuid())
  documentId      String
  versionId       String?
  fileName        String
  mime            String
  size            Int
  storageKey      String
  textContent     String?   @db.Text
  textExtractedAt DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())

  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version  DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  creator  User             @relation("DocumentAttachmentCreator", fields: [createdBy], references: [id])

  @@index([documentId])
  @@map("document_attachments")
}
