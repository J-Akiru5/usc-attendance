# Supabase (used by server API + Prisma scripts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase via @nuxtjs/supabase module (falls back to SUPABASE_URL / SUPABASE_ANON_KEY above,
# so you normally do NOT need to set these — NUXT_ prefix allows runtime override without rebuild)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Prisma (Supabase session pooler connection string, port 5432)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Seed admin account password (required for seed_auth.ts)
SEED_ADMIN_PASSWORD=your-admin-password-here

# Cloudflare R2 (photo upload — presigned URL endpoint)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-r2-bucket-name

# R2 public base URL (client-side — accessible to the browser)
# For R2.dev subdomain: https://pub-<hash>.r2.dev
# For custom domain:    https://photos.yourdomain.com
VITE_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# Public address of the deployed site (used in emailed verification / reset links)
SITE_URL=https://usc.syntaxure.dev
# Nuxt public site URL (OG images, absolute links)
NUXT_PUBLIC_SITE_URL=https://usc.syntaxure.dev

# Resend (password-reset and student verification emails)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="USC Attendance <noreply@syntaxure.dev>"
# Daily outbound-email budget (Resend's free plan allows ~100/day). The guard
# refuses politely at this number instead of letting the quota run out silently.
RESEND_DAILY_LIMIT=90

# Where signature images live (plan §11.1):
#   db         - bytes stay in Postgres (default, no extra setup)
#   r2         - upload to Cloudflare R2 using the R2_* values above
#   filesystem - development/e2e only; writes under SIGNATURE_STORAGE_DIR
SIGNATURE_STORAGE=db
SIGNATURE_STORAGE_DIR=.signature-store

# Shared secret for the daily signature-retention cron (Vercel sends it as a Bearer token)
CRON_SECRET=a-long-random-string

# QR token signing (server-only — never exposed to the client; rotate if leaked)
QR_SECRET=your-qr-signing-secret-here

# Salt for the client-IP hash in the audit log (benchmark BC-10). The raw IP is
# never stored; without a salt the log keeps no address hash at all (an
# unsalted IPv4 digest is reversible). Rotating it makes older hashes
# unlinkable to newer ones.
AUDIT_IP_SALT=a-long-random-string

# Where document & resolution attachments live (plan §8.8): object storage (the
# R2_* values above) when configured, the filesystem otherwise. Never the
# database. DOCUMENT_STORAGE=off disables uploads entirely.
DOCUMENT_STORAGE_PATH=.local/documents

# Student-ID photos for manual check-ins (T-0009). This is identity evidence,
# so it must live in its OWN private bucket - never the public event-photo
# bucket above. The server only reads it through an authenticated, audited
# route; no public URL is ever produced.
#
#   r2         - private Cloudflare R2 bucket (ATTENDANCE_PHOTO_BUCKET required)
#   filesystem - development/e2e only; ATTENDANCE_PHOTO_STORAGE_DIR
# When unset: R2 if ATTENDANCE_PHOTO_BUCKET is set, otherwise filesystem outside
# production and "not configured" in production.
ATTENDANCE_PHOTO_STORAGE=
ATTENDANCE_PHOTO_BUCKET=
ATTENDANCE_PHOTO_STORAGE_DIR=.local/attendance-photos
# How long an ID photo is kept before the daily purge deletes it (days).
# Default 90. This is the single place the window is configured.
ATTENDANCE_PHOTO_RETENTION_DAYS=90
# Optional dedicated HMAC key for the short-lived upload reference. Falls back
# to QR_SECRET when empty; rotating it invalidates un-sent references only.
ATTENDANCE_PHOTO_SECRET=
